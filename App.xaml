<Application x:Class="Hotel_Vasanov_ISP43.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hotel_Vasanov_ISP43"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0 0 10 0"/>
            <Setter Property="Padding" Value="14 8"/>
            <Setter Property="Background" Value="#E3EBF2"/>
            <Setter Property="BorderBrush" Value="#B7C9D9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0 5 0 13"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0 5 0 13"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0 5 12 13"/>
        </Style>
    </Application.Resources>
</Application>

