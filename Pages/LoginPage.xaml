<Page x:Class="Hotel_Vasanov_ISP43.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход" Background="#F5F7FA">
    <Grid> 
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Width="340" HorizontalAlignment="Center" Margin="20 42">
                <TextBlock Text="Вход" FontSize="28" Margin="0 0 0 22"/>
                <TextBlock Text="Электронная почта"/>
                <TextBox Name="EmailBox" MaxLength="100"/>
                <TextBlock Text="Пароль"/>
                <PasswordBox Name="PasswordInput" MaxLength="100"/>
                <TextBlock Text="Код с картинки"/>
                <Border Name="CaptchaBorder" Width="240" Height="60" HorizontalAlignment="Left" BorderBrush="#90A9BF" BorderThickness="1" Margin="0 7 0 5"/>
                <Button Name="RefreshButton" Content="Новый код" HorizontalAlignment="Left" Click="RefreshButton_Click" Margin="0 0 0 8"/>
                <TextBox Name="CaptchaInput" MaxLength="6"/>
                <TextBlock Name="StatusText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0 0 0 12"/>
                <Button Name="SignInButton" Content="Войти" Click="SignInButton_Click" HorizontalAlignment="Left" MinWidth="120"/>
                <Button Name="RegisterButton" Content="Зарегистрироваться" Click="RegisterButton_Click" HorizontalAlignment="Left" Margin="0 15 0 0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

