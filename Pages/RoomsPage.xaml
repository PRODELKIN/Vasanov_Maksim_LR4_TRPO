<Page x:Class="Hotel_Vasanov_ISP43.Pages.RoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Номера" Background="#F5F7FA">
    <Grid> 
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30 24">
                <TextBlock Text="Номера гостиницы" FontSize="26" Margin="0 0 0 7"/>
                <TextBlock Text="Выберите номер проживания. Оформление доступно после входа." Foreground="#52677A" Margin="0 0 0 15"/>
                <WrapPanel Margin="0 0 0 12">
                    <StackPanel Width="280" Margin="0 0 16 0">
                        <TextBlock Text="Поиск по категории"/>
                        <TextBox Name="CategorySearchBox" TextChanged="CategorySearchBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Width="250">
                        <TextBlock Text="Сортировка по цене за ночь"/>
                        <ComboBox Name="PriceSortBox" SelectedIndex="0" SelectionChanged="PriceSortBox_SelectionChanged" Margin="0 5 0 13" Padding="5">
                            <ComboBoxItem Content="Без сортировки"/>
                            <ComboBoxItem Content="От меньшей к большей"/>
                            <ComboBoxItem Content="От большей к меньшей"/>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
                <DataGrid Name="RoomsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Height="310" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер" Binding="{Binding Room_number}" Width="*"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category_name}" Width="2*"/>
                        <DataGridTextColumn Header="Мест" Binding="{Binding Room_capacity}" Width="*"/>
                        <DataGridTextColumn Header="Этаж" Binding="{Binding Floor_number}" Width="*"/>
                        <DataGridTextColumn Header="Цена за ночь" Binding="{Binding Base_rate, StringFormat=N2}" Width="1.5*"/>
                        <DataGridTextColumn Header="Состояние" Binding="{Binding Room_status}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Name="AdminRoomsPanel" Visibility="Collapsed" Margin="0 20 0 8">
                    <TextBlock Text="Добавление номера" FontSize="20" Margin="0 0 0 12"/>
                    <WrapPanel>
                        <StackPanel Width="120" Margin="0 0 12 0">
                            <TextBlock Text="Номер"/>
                            <TextBox Name="RoomNumberBox" MaxLength="10"/>
                        </StackPanel>
                        <StackPanel Width="180" Margin="0 0 12 0">
                            <TextBlock Text="Категория"/>
                            <ComboBox Name="CategoryBox" DisplayMemberPath="Category_name" SelectedValuePath="ID_Room_Category" Margin="0 5 0 13" Padding="5"/>
                        </StackPanel>
                        <StackPanel Width="80" Margin="0 0 12 0">
                            <TextBlock Text="Этаж (1–30)"/>
                            <TextBox Name="FloorBox" MaxLength="2"/>
                        </StackPanel>
                        <StackPanel Width="140" Margin="0 0 12 0">
                            <TextBlock Text="Цена за ночь, руб."/>
                            <TextBox Name="RoomRateBox" MaxLength="11"/>
                        </StackPanel>
                        <StackPanel Width="180" Margin="0 0 12 0">
                            <TextBlock Text="Состояние"/>
                            <ComboBox Name="RoomStatusBox" SelectedIndex="0" Margin="0 5 0 13" Padding="5">
                                <ComboBoxItem Content="Свободен"/>
                                <ComboBoxItem Content="На обслуживании"/>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                    <Button Name="AddRoomButton" Content="Добавить номер" Click="AddRoomButton_Click" HorizontalAlignment="Left"/>
                    <TextBlock Name="RoomStatusText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0 8 0 0"/>
                </StackPanel>
                <StackPanel Name="BookingPanel" Orientation="Horizontal" Margin="0 20 0 8">
                    <StackPanel>
                        <TextBlock Text="Заезд"/>
                        <DatePicker Name="StartDate" Width="155"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Выезд"/>
                        <DatePicker Name="EndDate" Width="155"/>
                    </StackPanel>
                    <Button Name="BookButton" Content="Забронировать" Click="BookButton_Click" VerticalAlignment="Bottom" Height="34" Margin="8 0 0 13"/>
                </StackPanel>
                <TextBlock Name="StatusText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0 0 0 14"/>
                <TextBlock Text="Дополнительные услуги" FontSize="20" Margin="0 8 0 10"/>
                <DataGrid Name="ServicesGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="180" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Услуга" Binding="{Binding Service_name}" Width="3*"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Current_price, StringFormat=N2}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Name="AdminServicesPanel" Visibility="Collapsed" Margin="0 20 0 8">
                    <TextBlock Text="Добавление услуги" FontSize="20" Margin="0 0 0 12"/>
                    <WrapPanel>
                        <StackPanel Width="300" Margin="0 0 12 0">
                            <TextBlock Text="Название услуги"/>
                            <TextBox Name="ServiceNameBox" MaxLength="60"/>
                        </StackPanel>
                        <StackPanel Width="160" Margin="0 0 12 0">
                            <TextBlock Text="Цена, руб."/>
                            <TextBox Name="ServicePriceBox" MaxLength="11"/>
                        </StackPanel>
                    </WrapPanel>
                    <Button Name="AddServiceButton" Content="Добавить услугу" Click="AddServiceButton_Click" HorizontalAlignment="Left"/>
                    <TextBlock Name="ServiceStatusText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0 8 0 0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
